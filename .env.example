# Copie para .env e preencha. Chave grátis: themoviedb.org → Configurações → API.
# Serve a chave v3 (32 caracteres) ou o "Token de Acesso de Leitura da API" (v4, começa com eyJ).
TMDB_API_KEY=
# Notas do IMDb, Rotten Tomatoes e Metacritic (opcional). Chave grátis: omdbapi.com/apikey.aspx (1.000 consultas/dia).
OMDB_API_KEY=
